# Backend configuration. Every value has a working default, so an empty
# environment runs correctly for local development.

# Port to listen on. Accepts "8080" or ":8080"; hosts differ on this.
PORT=8080

# Where the JSON state file lives. Point this at a mounted volume in
# production so playlists survive a redeploy.
DATA_FILE=./data/state.json

# Total play size per window. The assignment specifies 5 hours. Shorten it
# (for example 20s) to watch the cycle restart without waiting five hours.
CYCLE_DURATION=5h

# Default duration of a sync when the request does not specify one.
SYNC_DURATION=15s

# How far in the future a sync is scheduled. This lead time is what lets every
# window cross into the synced item on the same tick rather than as each
# client's message happens to arrive.
SYNC_LEAD=750ms

# CORS origin for a split deployment. Use the frontend's exact origin in
# production instead of "*".
CORS_ORIGIN=*

# Absolute or relative path to the built React app. Set this to serve the API
# and the frontend from one process; leave empty for an API-only deployment.
STATIC_DIR=
